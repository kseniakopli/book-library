venv/
__pycache__/
*.db
*.db-wal
*.db-shm

# Локальные бэкапы БД (backup_db.py) — страховочные копии, только на машине
backend/backups/
# Висячие обёртки от удаления открытых файлов (FUSE-артефакты)
.fuse_hidden*
.env
*.pyc
node_modules/

# Сборка фронтенда (на проде собирается в Docker, з.81)
frontend/dist/

# Playwright E2E (задача 68): отчёты и артефакты прогонов
frontend/test-results/
frontend/playwright-report/
frontend/.playwright/

# Токен Spotify (refresh_token) — приватный, живёт рядом с .env
spotify_token.json

# Внутренняя документация (ТЗ, план) — не публикуем на GitHub
docs/

# Уникальные промпты сервиса — приватно, только локально
prompt_config.py

# Личные выгрузки чтения (LiveLib и т.п.) — не в репозиторий
livelib-*.csv
backend/livelib-read.csv

# Промежуточные файлы точечного переноса данных на прод (з.103,
# scripts/sync_music_to_prod.py): music_sync.json / design_sync.json.
# Это СЛЕПОК содержимого базы на конкретный момент, а не код: в репозитории
# он мгновенно устаревает и вводит в заблуждение.
backend/*_sync.json

# Выгрузки полки (задача 35) — личные данные, оседают рядом с кодом,
# если сохранить файл не туда
nocturne-shelf-*.csv