# Что НЕ копировать в образ (з.81).
# ⚠ prompt_config.py здесь СОЗНАТЕЛЬНО не указан: он в .gitignore, но в образ
# попасть должен — без него приложение не стартует. Ключи в образ не пекутся,
# они приходят из fly secrets.

.git
.github
docs
documentation
venv
**/__pycache__
**/*.pyc

# node_modules пересобираются внутри образа (npm ci)
frontend/node_modules
frontend/dist
frontend/test-results
frontend/playwright-report

# локальные данные и секреты
**/.env
# Любые SQLite-файлы, где бы они ни лежали. Было по точному пути
# (backend/library.db) — и 02.08 обнаружилось, что в образ уехала
# backend/scripts/library.db: скрипт, запущенный из папки scripts/, создал
# там пустую базу, потому что DATABASE_URL задан относительным путём.
# Прод ею не пользуется (DATABASE_URL указывает на /data), но в образе
# лежала копия библиотеки, а сам факт означает, что скрипт мог молча
# работать с пустой базой и выдать «0 записей» вместо ошибки.
**/*.db
**/*.db-wal
**/*.db-shm
backend/backups
backend/spotify_token.json
backend/livelib-*.csv
